fruitbox.bowen.sh {
	reverse_proxy 127.0.0.1:3000
}

labs.bowen.sh {
	root * /srv/bowen-labs
	encode zstd gzip

	@immutable path /black-hole.webp /favicon.png /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	file_server
}

muster.bowen.sh {
	root * /srv/muster
	encode zstd gzip

	header {
		Cache-Control "no-cache"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
	}

	file_server
}

bowen.sh {
	root * /srv/portfolio
	encode zstd gzip

	@immutable path /black-hole.webp /favicon.png /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	file_server
}

www.bowen.sh {
	redir https://bowen.sh{uri} permanent
}
