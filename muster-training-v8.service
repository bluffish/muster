[Unit]
Description=Muster v8 entity-attention MAPPO training
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/muster-local-hex
ExecStart=/home/ubuntu/muster-local-hex/run_training_v8.sh
Restart=on-failure
RestartSec=15
KillSignal=SIGINT
TimeoutStopSec=90
StandardOutput=append:/home/ubuntu/muster-local-hex/runs/local-hex-v8-entity-attention-v1/train.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
