[Unit]
Description=Muster MAPPO training (%i)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/muster-local-hex
ExecStart=/home/ubuntu/muster-local-hex/ops/run_training.sh %i
Restart=on-failure
RestartSec=15
KillSignal=SIGINT
TimeoutStopSec=90
StandardError=inherit

[Install]
WantedBy=multi-user.target
