[Unit]
Description=Muster v9 side-equivariant MAPPO training
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/muster-local-hex
ExecStartPre=/usr/bin/mkdir -p /home/ubuntu/muster-local-hex/runs/local-hex-v9-side-equivariant-v1
ExecStart=/home/ubuntu/muster-local-hex/run_training_v9.sh
Restart=on-failure
RestartSec=15
KillSignal=SIGINT
TimeoutStopSec=90
StandardOutput=append:/home/ubuntu/muster-local-hex/runs/local-hex-v9-side-equivariant-v1/train.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
