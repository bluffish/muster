RUN_NAME=local-hex-v22-roles-v1
WANDB_NAME=bowen3-v22-roles-v1
TRAIN_ARGS=(
    --device cuda
    --warm-start runs/distilled_charger.pt
    --opponent mixed
    --mixed-scripted-fraction 0.25
    --opponent-pool-size 16
    --opponent-snapshot-every 25
    --opponent-latest-probability 0.5
    --soldiers 256
    --envs 256
    --rollout 150
    --action-repeat 3
    --updates 20000
    --epochs 4
    --minibatches 16
    --hidden-size 256
    --entity-size 16
    --tile-size 32
    --local-radius 2
    --mode-count 16
    --mode-size 16
    --mode-mi-beta 0.005
    --mode-mi-anneal-updates 4000
    --role-count 8
    --role-size 8
    --anchor-every 25
    --anchor-episodes 4
    --log-std-floor -0.8
    --memory-size 64
    --bptt-window 15
    --message-size 8
    --dtype bf16
    --compile
    --compile-mode max-autotune-no-cudagraphs
    --learning-rate 0.001
    --gamma 1.0
    --gae-lambda 0.941192
    --clip 0.2
    --value-coefficient 0.5
    --entropy-coefficient 0.0005
    --maximum-gradient-norm 0.5
    --target-kl 0.02
    --save-every 10
    --replay-every 5
    --seed 0
)
